{
  "name": "ipod-desktop",
  "productName": "iPod",
  "version": "3.0.0",
  "private": true,
  "description": "A free-floating, 3D iPod (5th generation) for your Windows desktop: click wheel, local music, Spotify, radio, podcasts, games and extras.",
  "author": "iPod Desktop contributors",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "lint": "eslint .",
    "icons": "electron scripts/make-icons.js",
    "vendor": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/three/build/three.module.min.js','src/renderer/vendor/three/three.module.min.js');fs.copyFileSync('node_modules/three/LICENSE','src/renderer/vendor/three/LICENSE')\"",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "test": "node --test \"test/**/*.test.js\" \"test/**/*.test.mjs\"",
    "e2e": "bash scripts/run-e2e.sh"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.2",
    "music-metadata": "^11.16.1"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "three": "^0.169.0"
  },
  "build": {
    "appId": "com.ipoddesktop.app",
    "productName": "iPod",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "iPod",
      "artifactName": "iPod-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "iPod-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "extendInfo": {
        "LSApplicationCategoryType": "public.app-category.music"
      },
      "fileAssociations": [
        {
          "ext": [
            "mp3",
            "m4a",
            "m4b",
            "aac",
            "flac",
            "wav",
            "ogg",
            "opus"
          ],
          "name": "Audio",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ]
    },
    "dmg": {
      "artifactName": "iPod-${version}-mac-${arch}.${ext}",
      "title": "iPod ${version}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "classyfiedcat-coder",
        "repo": "Ipod"
      }
    ]
  }
}
